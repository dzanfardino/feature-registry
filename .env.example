# API
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
TYPEORM_SYNC=true

# PostgreSQL (see docker-compose.yml)
DATABASE_URL=postgres://feature_registry:feature_registry@localhost:5432/feature_registry

# Web
VITE_API_URL=http://localhost:3000

# Reminder worker (@nestjs/schedule). Leave empty to disable outbound notifications.
# Accepts any HTTP webhook. Slack incoming-webhook URLs work as-is.
REMINDER_WEBHOOK_URL=
REMINDER_CRON=0 9 * * *

# Optional Jira Cloud/Server REST enrichment. When unset, links are stored as URLs only.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional Confluence Cloud REST enrichment. When unset, links are stored as URLs only.
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
